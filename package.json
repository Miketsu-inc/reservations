{
  "name": "reservations",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "workspaces": [
    "frontend/apps/*",
    "frontend/packages/*"
  ],
  "scripts": {
    "dev-jabulani": "vite --config frontend/apps/jabulani/vite.config.js --port 5173",
    "dev-tango": "vite --config frontend/apps/tango/vite.config.js --port 5174",
    "build-jabulani": "vite build --config frontend/apps/jabulani/vite.config.js",
    "build-tango": "vite build --config frontend/apps/tango/vite.config.js",
    "test": "vitest run",
    "lint": "eslint frontend --ext js,jsx --config frontend/eslint.config.js --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "mapbox-gl": "^3.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@react-email/ui": "^6.9.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.9.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
